# Copy to a real environment file on the host. Never commit live secrets.
# Never prefix payment or database secrets with VITE_ — they must stay server-only.

# Postgres (Neon or other). Leave unset in local preview to use embedded PGLite.
DATABASE_URL=

# Public site origin used by Better Auth callbacks. Example: https://navizindagi.vercel.app
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Required to create the first platform admin on an empty database.
# If unset, signed-in users cannot self-promote. Never prefix with VITE_.
ADMIN_BOOTSTRAP_EMAIL=

# TODO: add live Razorpay credentials to collect real Indian payments (UPI, cards, netbanking).
# Until both are set, the site stays in labelled sandbox mode and does not charge donors.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from the Razorpay dashboard. Server-only. Not VITE_.
RAZORPAY_WEBHOOK_SECRET=

# Auth flags. The production host should set VITE_AUTH_ENABLED=true.
# VITE_AUTH_ENABLED=true
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Optional public contact overrides — live values are also edited in Admin > Settings.
# PUBLIC_CONTACT_EMAIL=
# PUBLIC_CONTACT_PHONE=
