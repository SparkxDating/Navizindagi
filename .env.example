# Copy to a real environment file on the host. Never commit live secrets.
# Never prefix payment secrets with VITE_ — they must stay server-only.

# Postgres connection (Neon or other). Leave unset to use embedded PGLite in preview.
DATABASE_URL=

# TODO: add live Razorpay credentials to collect real Indian payments (UPI, cards, netbanking).
# Until both are set, the site stays in labelled sandbox mode and does not charge donors.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Auth is injected by the Grok deployer. Do not put broker secrets in frontend code.
# VITE_AUTH_ENABLED=true
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=

# Optional public contact overrides — the live values are edited in Admin > Settings.
# PUBLIC_CONTACT_EMAIL=
# PUBLIC_CONTACT_PHONE=
